<?xml version="1.0" encoding="utf-8"?>
<!-- Paquet MSI de Tout Compte Fait, une version (édition) par paquet (WiX 4, par machine, 64 bits). Construit par
     tools\Build-Installer.ps1 à partir de editions.json :
     wix build installer\Product.wxs -d Version=x.y.z -d PublishDir=<dossier publish> -d IconPath=<app.ico>
       -d EditionName="Tout Compte Fait Asso" -d ExeName=ToutCompteFaitAsso -d UpgradeCode=<GUID> -d InstallRoot="Tout Compte Fait" -d InstallFolder=Asso
       -d DataName=ToutCompteFait -d DataGuid=<GUID> -d BackupGuid=<GUID> [-d LauncherPath=<ToutCompteFait.exe>]
     Chaque version a son UpgradeCode, son dossier d'installation, sa clé de registre et ses raccourcis : plusieurs versions
     s'installent côte à côte sur un même poste. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="$(EditionName)" Manufacturer="TomLine prod&amp;co" Version="$(Version)"
           UpgradeCode="$(UpgradeCode)" Scope="perMachine" Language="1036" Codepage="1252">

    <MajorUpgrade AllowDowngrades="yes" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <!-- Recherches faites avant l'installation : raccourci déjà présent sur le bureau public ? drapeau posé par ce paquet ? -->
    <Property Id="DESKTOPLNK">
      <DirectorySearch Id="PublicDesktopDir" Path="[%PUBLIC]\Desktop" Depth="0">
        <FileSearch Id="DesktopLnkFile" Name="$(EditionName).lnk" />
      </DirectorySearch>
    </Property>
    <Property Id="DESKTOPFLAG">
      <RegistrySearch Id="DesktopFlagReg" Root="HKLM" Key="SOFTWARE\TomLine\$(DataName)" Name="DesktopShortcutManaged"
                      Type="raw" Bitness="always64" />
    </Property>
    <Icon Id="app.ico" SourceFile="$(IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <!-- C:\Program Files\Tout Compte Fait\<Version> : un seul dossier « Tout Compte Fait », un sous-dossier par version. -->
      <Directory Id="INSTALLROOT" Name="$(InstallRoot)">
      <Directory Id="INSTALLFOLDER" Name="$(InstallFolder)">

        <Component Id="MainExe" Guid="*">
          <File Id="MainExeFile" Source="$(PublishDir)\$(ExeName).exe" KeyPath="yes">
            <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="$(EditionName)"
                      WorkingDirectory="INSTALLFOLDER" Advertise="no" />
          </File>
        </Component>

        <!-- Raccourci sur le bureau (tous les utilisateurs) : composant PERMANENT (jamais retiré ni recréé par une mise à
             jour) et installé seulement s'il est absent. DESKTOPFLAG (registre) distingue la 1re mise à jour depuis
             l'ancien paquet, dont le raccourci était retiré avec l'ancienne version et doit donc être recréé. -->
        <Component Id="DesktopShortcutComp" Guid="*" Bitness="always64" Permanent="yes" Condition="NOT DESKTOPLNK OR NOT DESKTOPFLAG">
          <RegistryValue Root="HKLM" Key="SOFTWARE\TomLine\$(DataName)" Name="DesktopShortcutManaged" Type="integer" Value="1" KeyPath="yes" />
          <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="$(EditionName)"
                    Target="[INSTALLFOLDER]$(ExeName).exe" WorkingDirectory="INSTALLFOLDER" />
        </Component>

        <?ifdef LauncherPath?>
        <!-- Lanceur de compatibilité ToutCompteFait.exe : anciennes mises à jour automatiques et raccourcis existants. -->
        <Component Id="LegacyLauncher" Guid="*">
          <File Id="LegacyLauncherFile" Source="$(LauncherPath)" Name="ToutCompteFait.exe" KeyPath="yes" />
        </Component>
        <?endif?>

        <!-- Donnees (base SQLite) et Sauvegardes vivent à côté de l'exécutable, comme en version portable : ces dossiers
             doivent rester inscriptibles pour les utilisateurs standard. Ils sont créés VIDES : l'installateur ne
             contient et n'écrase jamais de base de données. -->
        <Directory Id="DATADIR" Name="Donnees">
          <Component Id="DataFolder" Guid="$(DataGuid)">
            <CreateFolder>
              <util:PermissionEx User="Users" GenericAll="yes" />
            </CreateFolder>
          </Component>
        </Directory>
        <Directory Id="BACKUPDIR" Name="Sauvegardes">
          <Component Id="BackupFolder" Guid="$(BackupGuid)">
            <CreateFolder>
              <util:PermissionEx User="Users" GenericAll="yes" />
            </CreateFolder>
          </Component>
        </Directory>

        <!-- Clé de registre propre à la version : InstallDir signale la version installée (mises à jour via MSI). -->
        <Component Id="AppRegistry" Guid="*" Bitness="always64">
          <RegistryKey Root="HKLM" Key="SOFTWARE\TomLine\$(DataName)" ForceCreateOnInstall="yes">
            <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
          </RegistryKey>
        </Component>

      </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="$(EditionName)" Level="1">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="DesktopShortcutComp" />
      <?ifdef LauncherPath?>
      <ComponentRef Id="LegacyLauncher" />
      <?endif?>
      <ComponentRef Id="DataFolder" />
      <ComponentRef Id="BackupFolder" />
      <ComponentRef Id="AppRegistry" />
    </Feature>

  </Package>

</Wix>