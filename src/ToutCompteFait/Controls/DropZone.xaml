<UserControl x:Class="ToutCompteFait.Controls.DropZone"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Root_Click">
        <Border x:Name="Back" CornerRadius="8" Background="#F5F9FF"/>
        <Rectangle x:Name="Dash" RadiusX="8" RadiusY="8" Stroke="#3B82F6" StrokeThickness="1.5" StrokeDashArray="4 3" SnapsToDevicePixels="True"/>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,10">
            <Viewbox Width="30" Height="30" HorizontalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path x:Name="Icon" Stroke="#2563EB" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M7 18 a4.5 4.5 0 0 1 -0.6 -8.96 a6 6 0 0 1 11.4 1.46 a3.75 3.75 0 0 1 -0.3 7.5 Z M12 12 V19 M9 14.5 L12 11.5 L15 14.5"/>
                </Canvas>
            </Viewbox>
            <TextBlock x:Name="TitleText" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="13" Foreground="#334155" TextAlignment="Center"/>
            <TextBlock x:Name="HintText" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11.5" Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>