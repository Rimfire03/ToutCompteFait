<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>12</LangVersion>
    <!-- Version du logiciel (Ã©dition) : -p:Edition=asso (dÃ©faut). Voir editions.json et Editions.cs. -->
    <Edition Condition="'$(Edition)' == ''">asso</Edition>
    <EditionLabel>$([System.String]::Copy('$(Edition)').Substring(0,1).ToUpperInvariant())$([System.String]::Copy('$(Edition)').Substring(1))</EditionLabel>
    <AssemblyName>ToutCompteFait$(EditionLabel)</AssemblyName>
    <RootNamespace>ToutCompteFait</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.12.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Company>TomLine prod&amp;co</Company>
    <Product>Tout Compte Fait $(EditionLabel)</Product>
    <Copyright>Â© TomLine prod&amp;co by Thomas Guidez</Copyright>
  </PropertyGroup>

  <!-- Canal de la build (posÃƒÂ© par tools\Release.ps1 -Channel dev : -p:ReleaseChannel=dev) : lu par App.DisplayVersion. -->
  <ItemGroup Condition="'$(ReleaseChannel)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ReleaseChannel</_Parameter1>
      <_Parameter2>$(ReleaseChannel)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Version du logiciel : lue par Editions.Current. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Edition</_Parameter1>
      <_Parameter2>$(Edition)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="TomLine.UI.Wpf" Version="1.3.0" />
    <!-- Texte des PDF numÃƒÂ©riques (sans OCR) ; l'OCR et le rendu des pages utilisent Windows (Windows.Media.Ocr / Windows.Data.Pdf). -->
    <PackageReference Include="PdfPig" Version="0.1.9" />
  </ItemGroup>

  <!-- Devlog (nouveautÃ©s) affichÃ© aprÃ¨s une mise Ã  jour : voir DevLog.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="devlog.json" LogicalName="devlog.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ToutCompteFait.Core\ToutCompteFait.Core.csproj" />
  </ItemGroup>

</Project>
