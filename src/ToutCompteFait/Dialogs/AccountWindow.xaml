<Window x:Class="ToutCompteFait.Dialogs.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compte" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BrushSurface}">
    <StackPanel Margin="22">
        <TextBlock x:Name="TitleText" Text="Compte" Style="{StaticResource TitleText}"/>
        <TextBlock Text="Nom du compte" Margin="0,12,0,4"/>
        <TextBox x:Name="NameBox"/>
        <TextBlock Text="Type" Margin="0,12,0,4"/>
        <ComboBox x:Name="KindCombo"/>
        <TextBlock Text="Identifiants sur le relevé de la banque (facultatif)" Margin="0,12,0,4"/>
        <TextBox x:Name="MatchBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" VerticalScrollBarVisibility="Auto"/>
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="Un ou plusieurs textes qui identifient ce compte dans l'en-tête du fichier téléchargé (numéro de compte, IBAN, nom du compte tel qu'écrit par la banque…), séparés par « ; » ou un par ligne. À l'import d'un relevé, le compte est alors choisi automatiquement. Espaces, points et tirets sont ignorés ; 4 caractères minimum."/>
        <CheckBox x:Name="ActiveBox" Content="Compte actif (proposé à la saisie)" IsChecked="True" Margin="0,12,0,0"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource BrushDangerDark}" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
            <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
