<Window x:Class="ToutCompteFait.Dialogs.BankImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ToutCompteFait.Views"
        xmlns:ctl="clr-namespace:ToutCompteFait.Controls"
        Title="Importer un relevé bancaire" Width="900" Height="720" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BrushBackground}">
    <Window.Resources>
        <v:InvertBoolToVisibilityConverter x:Key="InvertBoolToVis"/>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Importer les écritures de la banque" Style="{StaticResource TitleText}"/>
            <TextBlock Style="{StaticResource MutedText}"
                       Text="Fichier CSV ou OFX téléchargé depuis le site de la banque, ou relevé imprimé en PDF / image (lu par OCR puis vérifié par les soldes). Les opérations déjà saisies (même compte, même date, même montant) voient leur intitulé remplacé par celui de la banque ; si la date diffère de quelques jours, vous validez le rapprochement (orange) ; les autres sont ajoutées SANS produit ni charge : elles apparaissent en jaune dans les Opérations bancaires, à classer ensuite directement depuis la liste."/>
            <ctl:DropZone x:Name="ImportDrop" Height="84" Margin="0,12,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <Button Content="Choisir le fichier…" Style="{StaticResource PrimaryButton}" Click="Browse_Click"/>
            <TextBlock x:Name="FileText" Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="2" Text="Compte du relevé :" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="AccountCombo" Grid.Column="3" DisplayMemberPath="Name" SelectionChanged="Settings_Changed"/>
        </Grid>

        <!-- Colonnes (CSV) -->
        <Border x:Name="MappingBox" Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12,10" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Colonnes du fichier (vérifiez la détection automatique)" FontWeight="SemiBold"/>
                <UniformGrid Columns="5" Margin="0,8,0,0">
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Date" Style="{StaticResource MutedText}"/><ComboBox x:Name="DateCol" SelectionChanged="Settings_Changed"/></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Libellé" Style="{StaticResource MutedText}"/><ComboBox x:Name="LabelCol" SelectionChanged="Settings_Changed"/></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Montant (signé)" Style="{StaticResource MutedText}"/><ComboBox x:Name="AmountCol" SelectionChanged="Settings_Changed"/></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Débit" Style="{StaticResource MutedText}"/><ComboBox x:Name="DebitCol" SelectionChanged="Settings_Changed"/></StackPanel>
                    <StackPanel><TextBlock Text="Crédit" Style="{StaticResource MutedText}"/><ComboBox x:Name="CreditCol" SelectionChanged="Settings_Changed"/></StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <DataGrid x:Name="PreviewGrid" Grid.Row="3" Margin="0,12,0,0">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tone}" Value="New"><Setter Property="Background" Value="#FEF9C3"/></DataTrigger>
                        <DataTrigger Binding="{Binding Tone}" Value="Update"><Setter Property="Background" Value="#DBEAFE"/></DataTrigger>
                        <DataTrigger Binding="{Binding Tone}" Value="Skip"><Setter Property="Foreground" Value="#94A3B8"/></DataTrigger>
                        <DataTrigger Binding="{Binding Tone}" Value="Doubt"><Setter Property="Background" Value="#FFEDD5"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="90" ElementStyle="{StaticResource LeftCell}"/>
                <DataGridTextColumn Header="Libellé de la banque" Binding="{Binding Label}" Width="*" ElementStyle="{StaticResource LeftCell}"/>
                <DataGridTextColumn Header="Montant" Binding="{Binding AmountText}" Width="100" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource HeaderRight}"/>
                <DataGridTemplateColumn Header="Action" Width="420">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding ActionText}" Style="{StaticResource LeftCellPad}">
                                    <TextBlock.Visibility>
                                        <Binding Path="NeedsDecision" Converter="{StaticResource InvertBoolToVis}"/>
                                    </TextBlock.Visibility>
                                </TextBlock>
                                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                          DisplayMemberPath="Display" Margin="4,2,2,2" FontSize="12.5"
                                          SelectionChanged="Decision_Changed">
                                    <ComboBox.Visibility>
                                        <Binding Path="NeedsDecision" Converter="{StaticResource BoolToVis}"/>
                                    </ComboBox.Visibility>
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="WarningText" Foreground="#B45309" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <DockPanel Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="QueueText" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" Foreground="#2563EB"/>
                    <Button x:Name="SkipButton" Content="Passer ce relevé" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Click="Skip_Click"/>
                    <Button Content="Annuler" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
                    <Button x:Name="ImportButton" Content="Importer" Style="{StaticResource PrimaryButton}" Margin="0" Click="Import_Click" IsEnabled="False"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <CheckBox x:Name="PointBox" Content="Pointer les écritures du relevé (retrouvées ou créées)" IsChecked="True"/>
                    <CheckBox x:Name="AlignBox" Content="Pour les rapprochements validés, prendre la date de la banque" Margin="0,6,0,0"
                              Visibility="Collapsed"
                              ToolTip="Sinon la date saisie est conservée ; seul l'intitulé est remplacé."/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>

