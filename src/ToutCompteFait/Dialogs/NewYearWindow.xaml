<Window x:Class="ToutCompteFait.Dialogs.NewYearWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouvel exercice" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BrushBackground}">
    <StackPanel Margin="22">
        <TextBlock Text="Nouvel exercice comptable" Style="{StaticResource TitleText}"/>
        <TextBlock Style="{StaticResource MutedText}"
                   Text="Un exercice couvre une période (en général du 1er septembre au 31 août). Les produits et charges de l'exercice précédent sont recopiés ; les soldes et les reports sont repris automatiquement."/>
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Début" Margin="0,0,0,4"/>
                <DatePicker x:Name="StartPicker" SelectedDateChanged="Dates_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Fin" Margin="0,0,0,4"/>
                <DatePicker x:Name="EndPicker" SelectedDateChanged="Dates_Changed"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="Nom de l'exercice" Margin="0,14,0,4"/>
        <TextBox x:Name="LabelBox"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource BrushDangerDark}" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Annuler" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
            <Button Content="Créer l'exercice" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
