<Window x:Class="ToutCompteFait.Dialogs.DatabaseServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serveur de base de données" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BrushBackground}">
    <StackPanel Margin="24">
        <TextBlock Text="Base de données" Style="{StaticResource TitleText}"/>
        <TextBlock x:Name="Intro" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                   Text="Le logiciel peut utiliser un fichier SQLite (local ou sur un partage réseau) ou un serveur de base de données. Un serveur est conseillé dès que plusieurs personnes utilisent le logiciel. Changer de base redémarre le logiciel."/>

        <StackPanel x:Name="ModeRow" Orientation="Horizontal" Margin="0,16,0,0">
            <RadioButton x:Name="FileMode" Content="Fichier SQLite" Checked="Mode_Changed"/>
            <RadioButton x:Name="ServerMode" Content="Serveur de base de données" Checked="Mode_Changed"/>
        </StackPanel>

        <StackPanel x:Name="ServerPanel" Margin="0,12,0,0">
            <TextBlock Text="Moteur" Margin="0,0,0,4"/>
            <ComboBox x:Name="ProviderCombo" SelectionChanged="Provider_Changed"/>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Serveur (nom ou adresse)" Margin="0,0,0,4"/><TextBox x:Name="HostBox"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Port" Margin="0,0,0,4"/><TextBox x:Name="PortBox"/></StackPanel>
            </Grid>
            <TextBlock Text="Nom de la base" Margin="0,10,0,4"/>
            <TextBox x:Name="DatabaseBox"/>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Utilisateur du serveur" Margin="0,0,0,4"/><TextBox x:Name="UserBox"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Mot de passe" Margin="0,0,0,4"/><PasswordBox x:Name="PasswordBox" FontSize="13" Padding="6,5"/></StackPanel>
            </Grid>
            <CheckBox x:Name="SslBox" Content="Connexion chiffrée (SSL/TLS)" Margin="0,10,0,0"/>
            <TextBlock x:Name="Hint" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
            <WrapPanel Margin="0,12,0,0">
                <Button x:Name="TestButton" Content="Tester la connexion" Style="{StaticResource SecondaryButton}" Click="Test_Click"/>
                <Button x:Name="ExportButton" Content="Générer le fichier de configuration…" Style="{StaticResource SecondaryButton}" Click="ExportConfig_Click"/>
                <Button x:Name="ImportButton" Content="Charger un fichier de configuration…" Style="{StaticResource SecondaryButton}" Click="ImportConfig_Click"/>
                <Button x:Name="MigrateButton" Content="Copier les données actuelles vers ce serveur" Style="{StaticResource SecondaryButton}" Click="Migrate_Click"/>
            </WrapPanel>
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="4" Margin="0,12,0,0" Visibility="Collapsed"/>
        <TextBlock x:Name="BusyText" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Fermer" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
            <Button x:Name="SaveButton" Content="Enregistrer et redémarrer" Style="{StaticResource PrimaryButton}" Margin="0" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
