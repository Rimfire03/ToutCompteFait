<UserControl x:Class="ToutCompteFait.Views.BilanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="PrintButton" Content="🖨  Imprimer ▾" Style="{StaticResource PrimaryButton}" Click="Print_Click"
                            ToolTip="Édition synthétique ou détaillée du bilan, en PDF imprimable (document officiel)."/>
                    <Button Content="Exporter (CSV)" Style="{StaticResource SecondaryButton}" Click="Export_Click"/>
                    <Button x:Name="ValidateButton" Content="🔒  Valider l'exercice" Style="{StaticResource SuccessButton}" Click="Validate_Click" Margin="0"/>
                    <Button x:Name="ReopenButton" Content="Rouvrir l'exercice" Style="{StaticResource DangerButton}" Click="Reopen_Click" Margin="0" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Style="{StaticResource TitleText}"/>
                    <TextBlock x:Name="SubText" Style="{StaticResource MutedText}"/>
                </StackPanel>
            </DockPanel>

            <!-- Contrôles avant validation -->
            <Border x:Name="IssuesCard" Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="IssuesTitle" FontWeight="SemiBold"/>
                    <ItemsControl x:Name="IssuesList" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Synthèse -->
            <UniformGrid Columns="3" Margin="0,16,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="21" Background="#DCFCE7" VerticalAlignment="Top">
                            <TextBlock Text="↘" FontSize="20" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Produits" Style="{StaticResource MutedText}"/>
                            <TextBlock x:Name="ProductsTotal" FontSize="26" FontWeight="SemiBold"/>
                            <Border x:Name="ProductsPill" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="ProductsDelta" FontSize="11.5" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock x:Name="ProductsNote" Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0,5,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="21" Background="#FEE2E2" VerticalAlignment="Top">
                            <TextBlock Text="↗" FontSize="20" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Charges" Style="{StaticResource MutedText}"/>
                            <TextBlock x:Name="ChargesTotal" FontSize="26" FontWeight="SemiBold"/>
                            <Border x:Name="ChargesPill" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="ChargesDelta" FontSize="11.5" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock x:Name="ChargesNote" Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="21" Background="#DBEAFE" VerticalAlignment="Top">
                            <TextBlock Text="＝" FontSize="20" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Résultat net de l'exercice" Style="{StaticResource MutedText}"/>
                            <TextBlock x:Name="ResultTotal" FontSize="26" FontWeight="SemiBold"/>
                            <Border x:Name="ResultPill" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="ResultDelta" FontSize="11.5" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock x:Name="ResultNote" Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Compte de fonctionnement -->
            <TextBlock Text="Compte de fonctionnement" Style="{StaticResource SectionText}" Margin="0,18,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="●  Charges" FontWeight="SemiBold" Foreground="#B91C1C" Margin="2,0,0,6"/>
                    <DataGrid x:Name="ChargesGrid" MouseDoubleClick="Detail_DoubleClick" ToolTip="Double-clic sur une catégorie : détail des lignes du livre" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Catégorie" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource LeftCell}"/>
                            <DataGridTextColumn Header="Livre" Binding="{Binding CashText}" Width="86" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource HeaderRight}"/>
                            <DataGridTextColumn Header="Reports" Binding="{Binding AdjText}" Width="80" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource HeaderRight}"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalText}" Width="92" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource HeaderRight}"/>
                            <DataGridTemplateColumn Header="Part" Width="74">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Share}" Height="6" Margin="6,0" BorderThickness="0"
                                                     Background="#E8EEF5" Foreground="{Binding ShareBrush}" Visibility="{Binding ShareVisibility}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="●  Produits" FontWeight="SemiBold" Foreground="#15803D" Margin="2,0,0,6"/>
                    <DataGrid x:Name="ProductsGrid" MouseDoubleClick="Detail_DoubleClick" ToolTip="Double-clic sur une catégorie : détail des lignes du livre" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Catégorie" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource LeftCell}"/>
                            <DataGridTextColumn Header="Livre" Binding="{Binding CashText}" Width="86" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource HeaderRight}"/>
                            <DataGridTextColumn Header="Reports" Binding="{Binding AdjText}" Width="80" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource HeaderRight}"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalText}" Width="92" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource HeaderRight}"/>
                            <DataGridTemplateColumn Header="Part" Width="74">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Share}" Height="6" Margin="6,0" BorderThickness="0"
                                                     Background="#E8EEF5" Foreground="{Binding ShareBrush}" Visibility="{Binding ShareVisibility}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                       Text="« Reports » : régularisations entre exercices (payé l'exercice précédent pour cet exercice, payé cet exercice pour l'exercice suivant…). Voir « Reports entre exercices »."/>

            <!-- Opérations -->
            <TextBlock Text="Rentabilité des opérations" Style="{StaticResource SectionText}" Margin="0,18,0,6"/>
            <DataGrid x:Name="OperationsGrid" MouseDoubleClick="Detail_DoubleClick" ToolTip="Double-clic sur une opération : toutes les lignes de compte qui la concernent" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Opération" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource LeftCell}"/>
                    <DataGridTextColumn Header="Produits liés" Binding="{Binding Products}" Width="*" ElementStyle="{StaticResource LeftCell}"/>
                    <DataGridTextColumn Header="Charges liées" Binding="{Binding Charges}" Width="*" ElementStyle="{StaticResource LeftCell}"/>
                    <DataGridTextColumn Header="Produits" Binding="{Binding ProductsText}" Width="100" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource HeaderRight}"/>
                    <DataGridTextColumn Header="Charges" Binding="{Binding ChargesText}" Width="100" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource HeaderRight}"/>
                    <DataGridTextColumn Header="Rentabilité" Binding="{Binding ResultText}" Width="110" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource HeaderRight}"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="NoOperationText" Style="{StaticResource MutedText}" Margin="0,6,0,0" Visibility="Collapsed"
                       Text="Aucune opération définie : dans le Paramétrage du dossier, regroupez produits et charges d'un même événement (ex. Loto Octobre) pour voir sa rentabilité ici."/>

            <!-- Situation -->
            <TextBlock Text="Situation au dernier jour de l'exercice" Style="{StaticResource SectionText}" Margin="0,18,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ACTIF — soldes des comptes" FontWeight="SemiBold"/>
                        <ItemsControl x:Name="ActifList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}"/>
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="1" Background="#CBD5E1" Margin="0,8"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" x:Name="ActifTotal" FontWeight="Bold"/>
                            <TextBlock Text="TOTAL DE L'ACTIF" FontWeight="Bold"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="PASSIF" FontWeight="SemiBold"/>
                        <ItemsControl x:Name="PassifList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}"/>
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="1" Background="#CBD5E1" Margin="0,8"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" x:Name="PassifTotal" FontWeight="Bold"/>
                            <TextBlock Text="TOTAL DU PASSIF" FontWeight="Bold"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock x:Name="BalanceCheck" Margin="0,8,0,0" FontWeight="SemiBold"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>

