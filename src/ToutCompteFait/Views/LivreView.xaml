<UserControl x:Class="ToutCompteFait.Views.LivreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ToutCompteFait.Views">
    <UserControl.Resources>
        <v:InvertBoolToVisibilityConverter x:Key="InvertBoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleText}"/>
            <TextBlock x:Name="SubText" Style="{StaticResource MutedText}"/>
        </StackPanel>

        <!-- Barre d'outils -->
        <StackPanel Grid.Row="1" Margin="0,12,0,8">
            <WrapPanel>
                <Button x:Name="AddButton" Content="＋  Nouvelle écriture" Style="{StaticResource PrimaryButton}" Click="Add_Click"/>
                <Button x:Name="EditButton" Content="Modifier" Style="{StaticResource SecondaryButton}" Click="Edit_Click"/>
                <Button x:Name="MergeTransfersButton" Content="Fusionner les virements en double" Style="{StaticResource SecondaryButton}" Click="MergeTransfers_Click"
                        ToolTip="Un virement entre deux comptes apparaît deux fois (une sortie et une entrée) quand les deux relevés ont été importés : ce bouton les fusionne en un seul virement."/>
                <Button x:Name="ResetButton" Content="Réinitialiser la ventilation" Style="{StaticResource SecondaryButton}" Click="Reset_Click"
                        ToolTip="Retire toute la ventilation de la ligne sélectionnée : elle redevient « à ventiler » (le montant, la date et le libellé ne changent pas)."/>
                <Button x:Name="AssetButton" Content="Immobiliser…" Style="{StaticResource SecondaryButton}" Click="Asset_Click" Visibility="Collapsed"
                        ToolTip="Transforme cette dépense en immobilisation : sa valeur est étalée en charges sur sa durée d'utilisation (amortissement) au lieu de peser en une fois sur l'exercice."/>
                <Button x:Name="DeleteButton" Content="Annuler l'écriture" Style="{StaticResource DangerButton}" Click="Delete_Click"
                        ToolTip="Une écriture ne se supprime jamais : elle est annulée par une écriture inverse (contre-passation). L'original reste visible avec « Annulations »."/>
                <Button x:Name="BankButton" Content="🏦  Importer un relevé bancaire…" Style="{StaticResource SecondaryButton}" Click="BankImport_Click"/>
                <Button x:Name="FecImportButton" Content="Importer un FEC…" Style="{StaticResource SecondaryButton}" Click="FecImport_Click"
                        ToolTip="Reprend dans l'exercice affiché les écritures d'un Fichier des Écritures Comptables (FEC) qui touchent la banque ou la caisse, avec leurs produits et charges, et les soldes d'ouverture. Les achats et ventes sans règlement sont ignorés."/>
                <Button x:Name="ExportButton" Content="Exporter ▾" Style="{StaticResource SecondaryButton}" Click="Export_Click"
                        ToolTip="Livre-journal en PDF ou CSV, Fichier des Écritures Comptables (FEC) pour un contrôle fiscal ou un expert-comptable."/>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <TextBlock Text="Compte :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="AccountFilter" Width="150" DisplayMemberPath="Name" SelectionChanged="Filter_Changed"/>
                <TextBox x:Name="SearchBox" Width="170" Margin="10,0,0,0" TextChanged="Filter_TextChanged"
                         ToolTip="Rechercher dans le libellé, la catégorie ou le montant"/>
                <CheckBox x:Name="OnlyToFill" Content="À ventiler" Margin="12,0,0,0" Click="Filter_Click"
                          ToolTip="N'afficher que les écritures sans produit ni charge (jaune)"/>
                <CheckBox x:Name="OnlyIssues" Content="À corriger" Margin="12,0,0,0" Click="Filter_Click"
                          ToolTip="N'afficher que les écritures dont la ventilation est incohérente (rouge)"/>
                <CheckBox x:Name="ShowOperations" Content="Rentabilité" Margin="12,0,0,0" Click="ShowOperations_Click"
                          ToolTip="Afficher le panneau « Rentabilité des opérations » à droite du livre (masqué par défaut pour laisser la place au tableau)."/>
                <CheckBox x:Name="ShowCancelled" Content="Annulations" Margin="12,0,0,0" Click="ShowCancelled_Click"
                          ToolTip="Afficher aussi les écritures annulées et leurs écritures d'annulation (grisées). Le numéro d'ordre est continu."/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <Border x:Name="FillBanner" Background="#FEF9C3" BorderBrush="#FDE047" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock x:Name="FillText" Foreground="#713F12" TextWrapping="Wrap"/>
            </Border>
            <Border x:Name="IssueBanner" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock x:Name="IssueText" Foreground="#991B1B" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="OpsGap" Width="0"/>
                <ColumnDefinition x:Name="OpsCol" Width="0"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="EmptyState" Panel.ZIndex="5" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                        IsHitTestVisible="False" MaxWidth="460">
                <TextBlock Text="🏦" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Aucune écriture à afficher" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyStateText" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,0"
                           Text="Saisissez une écriture ou importez un relevé bancaire pour commencer."/>
            </StackPanel>
            <DataGrid x:Name="EntriesGrid" CanUserSortColumns="False" HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Grid_DoubleClick" SelectionChanged="Grid_SelectionChanged">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="ToolTip" Value="{Binding ProblemTip}"/>
                        <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
                        <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Problem}" Value="True">
                                <Setter Property="Background" Value="#FEF2F2"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ToFill}" Value="True">
                                <Setter Property="Background" Value="#FEF9C3"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsTransfer}" Value="True">
                                <Setter Property="Foreground" Value="#64748B"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Background" Value="#F1F5F9"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="80" ElementStyle="{StaticResource LeftCell}"/>
                    <DataGridTextColumn Header="Libellé" Binding="{Binding Label}" Width="2*" MinWidth="110" ElementStyle="{StaticResource LeftCell}"/>
                    <DataGridTextColumn Header="Moyen" Binding="{Binding ModeText}" Width="84" ElementStyle="{StaticResource LeftCell}"/>
                    <DataGridTemplateColumn Header="Pointé" Width="52">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Pointed, Mode=OneWay}" HorizontalAlignment="Center"
                                          Click="Pointed_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Compte" Binding="{Binding AccountText}" Width="100" ElementStyle="{StaticResource LeftCell}"/>
                    <!-- Sens du relevé bancaire : Débit = sortie d'argent, Crédit = entrée. -->
                    <DataGridTextColumn Header="Débit" Binding="{Binding OutText}" Width="80" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource HeaderRight}"/>
                    <DataGridTextColumn Header="Crédit" Binding="{Binding InText}" Width="80" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource HeaderRight}"/>
                    <DataGridTextColumn Header="Solde" Binding="{Binding BalanceText}" Width="88" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource HeaderRight}"/>
                    <DataGridTextColumn Header="Commentaire" Binding="{Binding CommentText}" Width="*" MinWidth="80" ElementStyle="{StaticResource LeftCell}"/>
                    <DataGridTextColumn Header="Justif." Binding="{Binding AttachText}" Width="54" ElementStyle="{StaticResource LeftCell}"/>
                    <DataGridTemplateColumn Header="Ventilation" Width="1.5*" MinWidth="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Breakdown}" Style="{StaticResource LeftCellPad}">
                                        <TextBlock.Visibility>
                                            <Binding Path="CanAssign" Converter="{StaticResource InvertBoolToVis}"/>
                                        </TextBlock.Visibility>
                                    </TextBlock>
                                    <ComboBox ItemsSource="{Binding Options}" SelectedIndex="0" DropDownClosed="Assign_DropDownClosed"
                                              Margin="6,2,2,2" FontSize="12.5"
                                              ToolTip="Choisissez le produit ou la charge : toute l'écriture y est classée. Pour répartir sur plusieurs catégories, utilisez « Modifier ».">
                                        <ComboBox.Visibility>
                                            <Binding Path="CanAssign" Converter="{StaticResource BoolToVis}"/>
                                        </ComboBox.Visibility>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Rentabilité des opérations, en direct -->
            <Border x:Name="OpsPanel" Grid.Column="2" Style="{StaticResource Card}" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Rentabilité des opérations" Style="{StaticResource SectionText}" Margin="0,0,0,2"/>
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="Produits liés − charges liées, mis à jour à chaque saisie. Les liens se règlent dans le Paramétrage du dossier."/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <ItemsControl x:Name="OperationsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,7">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ResultText}" FontWeight="Bold"
                                                           Foreground="{Binding ResultBrush}"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Soldes -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12,8">
            <WrapPanel x:Name="BalancesPanel"/>
        </Border>
    </Grid>
</UserControl>








