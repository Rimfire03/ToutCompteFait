<UserControl x:Class="ToutCompteFait.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleText}"/>
            <TextBlock x:Name="LockText" Style="{StaticResource MutedText}"/>
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="0,12,0,0" FontFamily="Segoe UI">
            <!-- Listes -->
            <TabItem Header="Produits et charges">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="3" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                               Text="Les listes de cet exercice (elles sont recopiées à la création de l'exercice suivant). Une catégorie déjà utilisée par une écriture ne peut pas être supprimée, seulement renommée."/>

                    <DockPanel Grid.Row="1">
                        <TextBlock DockPanel.Dock="Top" Text="Produits (recettes)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button x:Name="AddProduct" Content="＋ Ajouter" Style="{StaticResource PrimaryButton}" Tag="P" Click="AddCategory_Click"/>
                            <Button x:Name="RenameProduct" Content="Renommer" Style="{StaticResource SecondaryButton}" Tag="P" Click="RenameCategory_Click"/>
                            <Button x:Name="UpProduct" Content="↑" Style="{StaticResource SecondaryButton}" Tag="P" Click="UpCategory_Click"/>
                            <Button x:Name="DownProduct" Content="↓" Style="{StaticResource SecondaryButton}" Tag="P" Click="DownCategory_Click"/>
                            <Button x:Name="DeleteProduct" Content="Supprimer" Style="{StaticResource DangerButton}" Tag="P" Click="DeleteCategory_Click"/>
                        </WrapPanel>
                        <DataGrid x:Name="ProductsGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produit" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource LeftCell}"/>
                                <DataGridTextColumn Header="Opération" Binding="{Binding Operation}" Width="150" ElementStyle="{StaticResource LeftCell}"/>
                                <DataGridTextColumn Header="Lignes" Binding="{Binding Uses}" Width="60" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource HeaderRight}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <DockPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="Charges (dépenses)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button x:Name="AddCharge" Content="＋ Ajouter" Style="{StaticResource PrimaryButton}" Tag="C" Click="AddCategory_Click"/>
                            <Button x:Name="RenameCharge" Content="Renommer" Style="{StaticResource SecondaryButton}" Tag="C" Click="RenameCategory_Click"/>
                            <Button x:Name="UpCharge" Content="↑" Style="{StaticResource SecondaryButton}" Tag="C" Click="UpCategory_Click"/>
                            <Button x:Name="DownCharge" Content="↓" Style="{StaticResource SecondaryButton}" Tag="C" Click="DownCategory_Click"/>
                            <Button x:Name="DeleteCharge" Content="Supprimer" Style="{StaticResource DangerButton}" Tag="C" Click="DeleteCategory_Click"/>
                        </WrapPanel>
                        <DataGrid x:Name="ChargesGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Charge" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource LeftCell}"/>
                                <DataGridTextColumn Header="Opération" Binding="{Binding Operation}" Width="150" ElementStyle="{StaticResource LeftCell}"/>
                                <DataGridTextColumn Header="Lignes" Binding="{Binding Uses}" Width="60" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource HeaderRight}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Opérations -->
            <TabItem Header="Opérations (liens produits ↔ charges)">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="3" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                               Text="Une opération regroupe les produits et les charges d'un même événement (ex. « Loto Octobre » = produit Loto Octobre + charges Loto Octobre et Loto n+1). Sa rentabilité s'affiche à la saisie et dans le bilan."/>
                    <DockPanel Grid.Row="1">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button Content="＋ Nouvelle opération" Style="{StaticResource PrimaryButton}" Click="AddOperation_Click"/>
                            <Button Content="Renommer" Style="{StaticResource SecondaryButton}" Click="RenameOperation_Click"/>
                            <Button Content="Supprimer" Style="{StaticResource DangerButton}" Click="DeleteOperation_Click"/>
                            <Button Content="Associer les noms identiques" Style="{StaticResource SecondaryButton}" Click="AutoLinkOperations_Click"
                                    ToolTip="Crée une opération pour chaque produit et charge de même nom et les y rattache (les rattachements déjà faits ne sont pas modifiés). C'est aussi fait automatiquement à la création ou au renommage d'un produit ou d'une charge."/>
                        </WrapPanel>
                        <ListBox x:Name="OperationsBox" DisplayMemberPath="Name" FontSize="14" SelectionChanged="OperationsBox_SelectionChanged"/>
                    </DockPanel>
                    <DockPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock x:Name="OperationLinksTitle" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6"
                                   Text="Cochez les produits et charges de l'opération sélectionnée"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="OperationLinks"/>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Comptes -->
            <TabItem Header="Comptes bancaires">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10"
                               Text="Les comptes de l'association (banque, livret, caisse…). Le solde d'ouverture se saisit uniquement pour le tout premier exercice ; ensuite il est repris automatiquement de la clôture précédente."/>
                    <WrapPanel Margin="0,0,0,6">
                        <Button x:Name="AddAccountButton" Content="＋ Nouveau compte" Style="{StaticResource PrimaryButton}" Click="AddAccount_Click"/>
                        <Button x:Name="EditAccountButton" Content="Modifier" Style="{StaticResource SecondaryButton}" Click="EditAccount_Click"/>
                        <Button x:Name="OpeningButton" Content="Saisir le solde d'ouverture" Style="{StaticResource SecondaryButton}" Click="Opening_Click"/>
                        <Button x:Name="DeleteAccountButton" Content="Supprimer" Style="{StaticResource DangerButton}" Click="DeleteAccount_Click"/>
                    </WrapPanel>
                    <DataGrid x:Name="AccountsGrid" MaxHeight="360">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Compte" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource LeftCell}"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding KindText}" Width="220" ElementStyle="{StaticResource LeftCell}"/>
                            <DataGridTextColumn Header="Actif" Binding="{Binding ActiveText}" Width="70" ElementStyle="{StaticResource LeftCell}"/>
                            <DataGridTextColumn Header="Solde d'ouverture (€)" Binding="{Binding OpeningText}" Width="170" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource HeaderRight}"/>
                            <DataGridTextColumn Header="Solde de clôture (€)" Binding="{Binding ClosingText}" Width="170" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource HeaderRight}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>

            <!-- Exercice -->
            <TabItem Header="Exercice">
                <StackPanel Margin="0,12,0,0" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10"
                               Text="Période et nom de l'exercice affiché. Les dates servent à repérer les écritures mal datées avant la validation."/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Début" Margin="0,0,0,4"/><DatePicker x:Name="StartPicker"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Fin" Margin="0,0,0,4"/><DatePicker x:Name="EndPicker"/></StackPanel>
                    </Grid>
                    <TextBlock Text="Nom" Margin="0,12,0,4"/>
                    <TextBox x:Name="YearLabelBox"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="SavePeriodButton" Content="Enregistrer" Style="{StaticResource PrimaryButton}" Click="SavePeriod_Click"/>
                        <Button x:Name="DeleteYearButton" Content="Supprimer cet exercice (vide)" Style="{StaticResource DangerButton}" Click="DeleteYear_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="YearInfo" Style="{StaticResource MutedText}" Margin="0,14,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- Utilisateurs (administrateur) -->
            <TabItem x:Name="UsersTab" Header="Utilisateurs">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10"
                               Text="Seul un administrateur crée les comptes. Rôles : Administrateur (tous les droits), Trésorier (saisie, reports, structure, validation), Lecteur (consultation seule). Le mot de passe saisi à la création est provisoire : la personne devra le changer à sa première connexion."/>
                    <WrapPanel Margin="0,0,0,6">
                        <Button Content="＋ Nouvel utilisateur" Style="{StaticResource PrimaryButton}" Click="AddUser_Click"/>
                        <Button Content="Modifier" Style="{StaticResource SecondaryButton}" Click="EditUser_Click"/>
                        <Button Content="Réinitialiser le mot de passe" Style="{StaticResource SecondaryButton}" Click="ResetPassword_Click"/>
                        <Button Content="⬇  Télécharger la configuration" Style="{StaticResource SecondaryButton}" Click="ExportConfig_Click"
                                ToolTip="Fichier contenant les informations de connexion à la base de données : à fournir au premier lancement d'un autre poste."/>
                    </WrapPanel>
                    <DataGrid x:Name="UsersGrid" MaxHeight="420" MouseDoubleClick="UsersGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Identifiant" Binding="{Binding UserName}" Width="160" ElementStyle="{StaticResource LeftCell}"/>
                            <DataGridTextColumn Header="Nom affiché" Binding="{Binding DisplayName}" Width="*" ElementStyle="{StaticResource LeftCell}"/>
                            <DataGridTextColumn Header="Rôle" Binding="{Binding RoleText}" Width="140" ElementStyle="{StaticResource LeftCell}"/>
                            <DataGridTextColumn Header="État" Binding="{Binding StateText}" Width="150" ElementStyle="{StaticResource LeftCell}"/>
                            <DataGridTextColumn Header="Dernière connexion" Binding="{Binding LastLoginText}" Width="160" ElementStyle="{StaticResource LeftCell}"/>
                            <DataGridTextColumn Header="Créé par" Binding="{Binding CreatedBy}" Width="140" ElementStyle="{StaticResource LeftCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>

            <!-- Base de données (administrateur) -->
            <TabItem x:Name="DbTab" Header="Base de données">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,12,20" MaxWidth="980" HorizontalAlignment="Left">
                        <TextBlock Text="Base utilisée" Style="{StaticResource SectionText}" Margin="0,0,0,4"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="DbDescription" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DbDetails" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                   Text="Toutes les données sont dans la base (fichier SQLite ou serveur PostgreSQL / MariaDB / SQL Server), jamais dans le programme. Un seul poste écrit à la fois, les autres lisent."/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="ServerButton" Content="Serveur de base de données…" Style="{StaticResource SecondaryButton}" Click="Server_Click"/>
                            <Button x:Name="ChangeDbButton" Content="Utiliser un autre fichier SQLite…" Style="{StaticResource SecondaryButton}" Click="ChangeDb_Click"/>
                            <Button Content="Exporter une copie (fichier SQLite)…" Style="{StaticResource SecondaryButton}" Click="ExportDb_Click"/>
                        </WrapPanel>

                        <TextBlock Text="Sauvegardes" Style="{StaticResource SectionText}"/>
                        <WrapPanel>
                            <Button x:Name="BackupNowButton" Content="Sauvegarder maintenant" Style="{StaticResource PrimaryButton}" Click="BackupNow_Click"/>
                            <Button x:Name="RestoreButton" Content="Restaurer la sélection…" Style="{StaticResource DangerButton}" Click="Restore_Click"/>
                            <Button Content="Supprimer" Style="{StaticResource SecondaryButton}" Click="DeleteBackup_Click"/>
                            <Button Content="Ouvrir le dossier" Style="{StaticResource SecondaryButton}" Click="OpenBackupFolder_Click"/>
                        </WrapPanel>
                        <DataGrid x:Name="BackupsGrid" MaxHeight="230" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="150" ElementStyle="{StaticResource LeftCell}"/>
                                <DataGridTextColumn Header="Nature" Binding="{Binding Kind}" Width="*" ElementStyle="{StaticResource LeftCell}"/>
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="140" ElementStyle="{StaticResource LeftCell}"/>
                                <DataGridTextColumn Header="Schéma" Binding="{Binding SchemaText}" Width="70" ElementStyle="{StaticResource LeftCell}"/>
                                <DataGridTextColumn Header="Taille" Binding="{Binding SizeText}" Width="90" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource HeaderRight}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Sauvegarde automatique" Style="{StaticResource SectionText}"/>
                        <WrapPanel VerticalAlignment="Center">
                            <CheckBox x:Name="AutoBackupBox" Content="Activer" Margin="0,0,16,0" VerticalAlignment="Center" Click="AutoBackup_Changed"/>
                            <ComboBox x:Name="FrequencyBox" Width="150" SelectionChanged="AutoBackup_Selection" Margin="0,0,10,0"/>
                            <TextBlock Text="à" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="BackupTimeBox" Width="64" LostFocus="BackupTime_LostFocus" Margin="0,0,16,0"/>
                            <TextBlock Text="Conserver" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="KeepBox" Width="52" LostFocus="Keep_LostFocus"/>
                            <TextBlock Text="sauvegardes (0 = toutes)" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </WrapPanel>
                        <TextBlock x:Name="AutoBackupInfo" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>

                        <TextBlock Text="Script SQL" Style="{StaticResource SectionText}"/>
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   Text="Exécute un fichier .sql sur la base actuelle (par ex. le script PostgreSQL généré à partir d'une base de test, qui remplace les tables de l'application). Une sauvegarde est faite avant ; si le script échoue, rien n'est modifié."/>
                        <Button x:Name="SqlScriptButton" Content="Exécuter un script SQL…" Style="{StaticResource DangerButton}"
                                HorizontalAlignment="Left" Margin="0,8,0,0" Click="SqlScript_Click"/>

                        <TextBlock Text="Vider la base de données" Style="{StaticResource SectionText}"/>
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   Text="Supprime toutes les données (exercices, comptes bancaires, écritures, ventilations, justificatifs) mais conserve les comptes utilisateurs et le journal. Réservé aux administrateurs. Une sauvegarde est faite avant ; l'opération est irréversible sans cette sauvegarde. Si des exercices sont validés (documents comptables à conserver), leur livre et leur FEC sont d'abord archivés et une phrase de confirmation spécifique est exigée."/>
                        <Button x:Name="ResetDataButton" Content="Vider la base (conserver les utilisateurs)…" Style="{StaticResource DangerButton}"
                                HorizontalAlignment="Left" Margin="0,8,0,0" Click="ResetData_Click"/>

                        <TextBlock Text="Journal des opérations sensibles" Style="{StaticResource SectionText}"/>
                        <DataGrid x:Name="AuditGrid" MaxHeight="280">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding At}" Width="140" ElementStyle="{StaticResource LeftCell}"/>
                                <DataGridTextColumn Header="Utilisateur" Binding="{Binding User}" Width="130" ElementStyle="{StaticResource LeftCell}"/>
                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="200" ElementStyle="{StaticResource LeftCell}"/>
                                <DataGridTextColumn Header="Détail" Binding="{Binding Detail}" Width="*" ElementStyle="{StaticResource LeftCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Mises à jour du logiciel -->
            <TabItem x:Name="UpdateTab" Header="Mises à jour">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,12,20" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="Version du logiciel" Style="{StaticResource SectionText}" Margin="0,0,0,4"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="VersionText" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Les mises à jour sont publiées sur GitHub (dépôt Rimfire03/ToutCompteFait). Seul le programme est remplacé : la base de données, les réglages et les sauvegardes ne sont jamais touchés, et une sauvegarde de la base est faite juste avant l'installation."/>
                            </StackPanel>
                        </Border>
                        <CheckBox x:Name="AutoUpdateBox" Content="Vérifier automatiquement au démarrage (proposé aux administrateurs)" Margin="0,12,0,0" Click="AutoUpdate_Changed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Canal :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ChannelBox" Width="120" SelectionChanged="Channel_Changed"
                                      ToolTip="Main : versions stables. Dev : versions de test (préversions)."/>
                        </StackPanel>
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="CheckUpdateButton" Content="Vérifier maintenant" Style="{StaticResource PrimaryButton}" Click="CheckUpdate_Click"/>
                            <Button x:Name="InstallUpdateButton" Content="Télécharger et installer" Style="{StaticResource SuccessButton}"
                                    Click="InstallUpdate_Click" Visibility="Collapsed"/>
                        </WrapPanel>
                        <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>



