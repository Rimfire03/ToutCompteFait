<UserControl x:Class="ToutCompteFait.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleText}"/>
            <TextBlock Style="{StaticResource MutedText}" MaxWidth="900" HorizontalAlignment="Left"
                       Text="Un report corrige le résultat quand un paiement ou un encaissement tombe sur un autre exercice que celui auquel il se rapporte (par ex. des lots de loto payés en juin pour le loto d'octobre). Ce qui est prévu pour l'exercice suivant lui est transmis automatiquement."/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,8">
            <Button x:Name="AddButton" Content="＋  Ajouter un report" Style="{StaticResource PrimaryButton}" Click="Add_Click"/>
            <Button x:Name="EditButton" Content="Modifier / affecter" Style="{StaticResource SecondaryButton}" Click="Edit_Click"/>
            <Button x:Name="DeleteButton" Content="Supprimer" Style="{StaticResource DangerButton}" Click="Delete_Click"/>
        </StackPanel>

        <Border x:Name="WarnBanner" Grid.Row="2" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                CornerRadius="6" Padding="12,8" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock x:Name="WarnText" Foreground="#92400E" TextWrapping="Wrap"/>
        </Border>

        <DataGrid x:Name="AdjGrid" Grid.Row="3" SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_DoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Unassigned}" Value="True">
                            <Setter Property="Background" Value="#FFFBEB"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Intitulé" Binding="{Binding Label}" Width="*" MinWidth="160" ElementStyle="{StaticResource LeftCell}"/>
                <DataGridTextColumn Header="Nature" Binding="{Binding Nature}" Width="80" ElementStyle="{StaticResource LeftCell}"/>
                <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="170" ElementStyle="{StaticResource LeftCell}"/>
                <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="300" ElementStyle="{StaticResource LeftCell}"/>
                <DataGridTextColumn Header="Effet" Binding="{Binding Effect}" Width="100" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource HeaderRight}"/>
                <DataGridTextColumn Header="Origine" Binding="{Binding Origin}" Width="190" ElementStyle="{StaticResource LeftCell}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

