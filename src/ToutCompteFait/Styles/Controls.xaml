<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette et contrôles génériques (boutons, champs, listes, cases, grille, cartes, barres de défilement) :
         paquet partagé TomLine.UI.Wpf, fusionné par App.xaml. Ce fichier ne garde que les réglages propres à
         Tout Compte Fait. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/TomLine.UI.Wpf;component/Themes/Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Pas de Foreground ici : un TextBlock hérite de la couleur de son conteneur (barre latérale sombre, boutons...). -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- Titre de section de Tout Compte Fait (la variante partagée est un libellé gris plus discret). -->
    <Style x:Key="SectionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,12,0,6"/>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>

    <!-- Grille : style partagé, avec les réglages de comportement de Tout Compte Fait (lecture seule, pas de
         suppression de ligne, en-têtes de colonnes seulement). -->
    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushPrimaryLight}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LeftCell" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="HeaderRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>
    <Style x:Key="LeftCellPad" TargetType="TextBlock" BasedOn="{StaticResource LeftCell}">
        <Setter Property="Margin" Value="12,0,0,0"/>
        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
    </Style>
    <Style x:Key="RightCell" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>

</ResourceDictionary>
