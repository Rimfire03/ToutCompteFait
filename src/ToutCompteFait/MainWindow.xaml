<Window x:Class="ToutCompteFait.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:ToutCompteFait"
        xmlns:ctl="clr-namespace:ToutCompteFait.Controls"
        Title="Tout Compte Fait" Height="860" Width="1480" MinWidth="1100" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BrushBackground}">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" Padding="14,9" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSidebarSelected}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Pied de page : identique à FiltresApp (état de l'accès à gauche, © au centre, version + puce à droite) -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushSidebar}" Padding="16,8"
                BorderThickness="0,1,0,0" BorderBrush="{StaticResource BrushSidebarBorder}">
            <Grid>
                <!-- Version de l'application et de la base, tout à droite. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source={x:Static app:App.DisplayVersion}, StringFormat='Core v{0}'}" FontSize="11" Foreground="#64748B"/>
                    <TextBlock x:Name="DbVersionText" FontSize="11" Foreground="#64748B" Margin="12,0,0,0"/>
                    <TextBlock x:Name="DbModeText" FontSize="11" Foreground="#64748B" Margin="6,0,0,0"/>
                    <!-- Puce d'état de la base : grise (vérification), verte (accessible), orange (lecture seule), rouge (connexion perdue). -->
                    <Ellipse Width="9" Height="9" Margin="6,1,0,0" VerticalAlignment="Center"
                             DataContext="{x:Static app:App.DatabaseHealth}" ToolTip="{Binding Tooltip}"
                             ToolTipService.ShowDuration="20000">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#94A3B8"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOk}" Value="True">
                                        <Setter Property="Fill" Value="#16A34A"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsOk}" Value="True"/>
                                            <Condition Binding="{Binding IsReadOnlyMode}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Fill" Value="#F59E0B"/>
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding IsDown}" Value="True">
                                        <Setter Property="Fill" Value="#DC2626"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="Connexion à la base perdue" FontSize="11" Foreground="#DC2626" FontWeight="SemiBold" Margin="6,0,0,0"
                               DataContext="{x:Static app:App.DatabaseHealth}"
                               Visibility="{Binding IsDown, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <TextBlock Text="© TomLine prod&amp;co by Thomas Guidez  ·  Tout Compte Fait" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                <!-- État de l'accès en écriture, aligné à gauche (à la place de l'état de licence de FiltresApp). -->
                <TextBlock x:Name="AccessFooter" FontSize="11" Foreground="#64748B" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Barre latérale -->
            <Border Grid.Column="0" Background="{StaticResource BrushSidebar}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource BrushSidebarBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,18,16,8">
                        <ctl:AppLogo Width="60" Height="60" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                        <TextBlock Text="Tout Compte Fait" FontSize="19" FontWeight="Bold" Foreground="{StaticResource BrushTextOnDark}"/>
                        <TextBlock Text="Livre de trésorerie" FontSize="11" Foreground="#94A3B8" Margin="0,1,0,0"/>

                        <Border Background="#152138" CornerRadius="6" Padding="10,8" Margin="0,16,0,0"
                                BorderBrush="{StaticResource BrushSidebarBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Exercice" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,4"/>
                                <ComboBox x:Name="YearCombo" SelectionChanged="YearCombo_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" Foreground="Black"/>
                                                <TextBlock Text="  🔒" Foreground="Black"
                                                           Visibility="{Binding Validated, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock x:Name="YearStatus" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="YearPeriod" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="NewYearButton" Content="＋  Nouvel exercice" Style="{StaticResource SecondaryButton}"
                                Margin="0,10,0,0" Click="NewYear_Click"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BrushSidebarBorder}" Margin="16,8,16,10"/>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10">
                        <!-- Utilisateur connecté -->
                        <Border Background="#152138" CornerRadius="6" Padding="10,8" Margin="12,0,12,8"
                                BorderBrush="{StaticResource BrushSidebarBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="UserNameText" Foreground="{StaticResource BrushTextOnDark}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="UserRoleText" Foreground="#94A3B8" FontSize="11.5"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Mot de passe" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="12"
                                            Click="ChangePassword_Click"/>
                                    <Button Content="Déconnexion" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="12"
                                            Margin="0" Click="Logout_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Height="1" Background="{StaticResource BrushSidebarBorder}" Margin="16,4,16,8"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="nav" Content="⚙   Paramètres" Checked="Nav_Checked" Tag="settings"/>
                        <RadioButton x:Name="NavHelp" Style="{StaticResource NavButton}" GroupName="nav" Content="❓   Aide" Checked="Nav_Checked" Tag="help"/>
                    </StackPanel>

                    <StackPanel>
                        <RadioButton x:Name="NavLivre" Style="{StaticResource NavButton}" GroupName="nav" Content="📒   Livre (saisie)" Checked="Nav_Checked" Tag="livre" IsChecked="True"/>
                        <RadioButton x:Name="NavBilan" Style="{StaticResource NavButton}" GroupName="nav" Content="📊   Bilan et opérations" Checked="Nav_Checked" Tag="bilan"/>
                        <RadioButton x:Name="NavReports" Style="{StaticResource NavButton}" GroupName="nav" Content="🔁   Reports entre exercices" Checked="Nav_Checked" Tag="reports"/>
                        <RadioButton x:Name="NavMembers" Style="{StaticResource NavButton}" GroupName="nav" Content="🧾   Remboursements membres" Checked="Nav_Checked" Tag="members"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Contenu -->
            <DockPanel Grid.Column="1">
                <Border x:Name="ReadOnlyBanner" DockPanel.Dock="Top" Background="#FFFBEB" BorderBrush="#FDE68A"
                        BorderThickness="0,0,0,1" Padding="18,10" Visibility="Collapsed">
                    <DockPanel>
                        <Button x:Name="TakeOverButton" DockPanel.Dock="Right" Content="Reprendre l'écriture" Style="{StaticResource SecondaryButton}"
                                Margin="12,0,0,0" Click="TakeOver_Click"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚠" FontSize="15" Foreground="#D97706" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ReadOnlyText" TextWrapping="Wrap" Foreground="#92400E" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="780"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ContentControl x:Name="Host" Margin="22,18,22,12" Foreground="{StaticResource BrushTextPrimary}"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>




