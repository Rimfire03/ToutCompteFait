<Window x:Class="ComptaAepby.Dialogs.StatementOcrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lire un relevé PDF ou une image" Width="1400" Height="800" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BrushBackground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Lire un relevé imprimé (PDF ou image)" Style="{StaticResource TitleText}"/>
            <TextBlock Style="{StaticResource MutedText}"
                       Text="Le texte est lu directement dans un PDF numérique, ou reconnu par l'OCR de Windows pour un scan ou une photo (hors ligne). La lecture n'est jamais crue sur parole : le relevé doit « tomber juste » (ancien solde + opérations = nouveau solde) avant de pouvoir être importé ; sinon la ligne fautive est à corriger en regard de l'image."/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BrowseButton" Content="Choisir les relevés…" Style="{StaticResource PrimaryButton}" Click="Browse_Click"/>
            <TextBlock x:Name="FileText" Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="2" Text="Profil :" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ProfileCombo" Grid.Column="3" DisplayMemberPath="Name" SelectionChanged="Profile_Changed"/>
            <TextBlock Grid.Column="4" Text="Année :" VerticalAlignment="Center" Margin="12,0,8,0"
                       ToolTip="À remplir seulement si les dates du relevé n'indiquent pas l'année."/>
            <TextBox x:Name="YearBox" Grid.Column="5" LostFocus="Year_LostFocus" ToolTip="À remplir seulement si les dates du relevé n'indiquent pas l'année."/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Compte :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="AccountPick" Width="330" DisplayMemberPath="Display" SelectionChanged="Account_Changed"
                              ToolTip="Un PDF peut regrouper plusieurs comptes : choisissez celui à importer."/>
                    <StackPanel x:Name="BalanceBox" Orientation="Horizontal">
                        <TextBlock Text="Ancien solde :" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <TextBox x:Name="OpeningBox" Width="100" TextChanged="Balance_Changed" ToolTip="Lu sur le relevé ; corrigez ou saisissez-le si besoin."/>
                        <TextBlock Text="Nouveau solde :" VerticalAlignment="Center" Margin="12,0,6,0"/>
                        <TextBox x:Name="ClosingBox" Width="100" TextChanged="Balance_Changed" ToolTip="Lu sur le relevé ; corrigez ou saisissez-le si besoin."/>
                    </StackPanel>
                    <TextBlock x:Name="MethodText" VerticalAlignment="Center" Margin="16,0,0,0" Style="{StaticResource MutedText}"/>
                </StackPanel>
                <DataGrid x:Name="RowsGrid" Grid.Row="1" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Single" SelectionChanged="Rows_SelectionChanged" AutoGenerateColumns="False">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tone}" Value="Bad"><Setter Property="Background" Value="#FEE2E2"/></DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="Warn"><Setter Property="Background" Value="#FFEDD5"/></DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="Off"><Setter Property="Foreground" Value="#94A3B8"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Inclure" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="56"/>
                        <DataGridTextColumn Header="Relevé" Binding="{Binding Source}" IsReadOnly="True" Width="66" ElementStyle="{StaticResource LeftCell}"/>
                        <DataGridTextColumn Header="Page" Binding="{Binding Page}" IsReadOnly="True" Width="44" ElementStyle="{StaticResource LeftCell}"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="92" ElementStyle="{StaticResource LeftCell}"/>
                        <DataGridTextColumn Header="Libellé" Binding="{Binding Label}" Width="*" MinWidth="200" ElementStyle="{StaticResource LeftCell}"/>
                        <DataGridTextColumn Header="Montant" Binding="{Binding AmountText}" Width="96"
                                            ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource HeaderRight}"/>
                        <DataGridTextColumn Header="Solde lu" Binding="{Binding BalanceText}" IsReadOnly="True" Width="84"
                                            ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource HeaderRight}"/>
                        <DataGridTextColumn Header="À vérifier" Binding="{Binding Alert}" IsReadOnly="True" Width="150" ElementStyle="{StaticResource LeftCell}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="◀" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="PrevPage_Click"/>
                    <TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="90"/>
                    <Button Content="▶" Style="{StaticResource SecondaryButton}" Margin="0,0,16,0" Click="NextPage_Click"/>
                    <Button Content="−" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="ZoomOut_Click" ToolTip="Réduire l'image"/>
                    <Button Content="+" Style="{StaticResource SecondaryButton}" Margin="0" Click="ZoomIn_Click" ToolTip="Agrandir l'image"/>
                </StackPanel>
                <Border Grid.Row="1" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Background="White">
                    <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="ImageHost" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Image x:Name="PageImage" Stretch="Uniform"/>
                            <Canvas x:Name="Overlay" IsHitTestVisible="False"/>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <Border x:Name="CheckBanner" Padding="12,8" CornerRadius="6" Background="{StaticResource BrushWarningLight}">
                <StackPanel>
                    <TextBlock x:Name="CheckTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CheckDetails" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="MessagesText" Foreground="#B45309" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <DockPanel Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Annuler" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
                    <Button x:Name="UseButton" Content="Utiliser ces opérations" Style="{StaticResource PrimaryButton}" Margin="0"
                            Click="Use_Click" IsEnabled="False"/>
                </StackPanel>
                <CheckBox x:Name="AckBox" VerticalAlignment="Center" Visibility="Collapsed" Checked="Ack_Changed" Unchecked="Ack_Changed"
                          Content="Aucun solde n'a pu être lu : je certifie avoir comparé chaque ligne avec le relevé."/>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
