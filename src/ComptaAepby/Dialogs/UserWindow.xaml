<Window x:Class="ComptaAepby.Dialogs.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Utilisateur" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BrushBackground}">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" Style="{StaticResource TitleText}"/>
        <TextBlock x:Name="Intro" Style="{StaticResource MutedText}"/>

        <StackPanel x:Name="IdentityPanel">
            <TextBlock Text="Identifiant de connexion" Margin="0,14,0,4"/>
            <TextBox x:Name="UserNameBox"/>
            <TextBlock Text="Nom affiché" Margin="0,12,0,4"/>
            <TextBox x:Name="DisplayBox"/>
        </StackPanel>

        <StackPanel x:Name="RolePanel">
            <TextBlock Text="Rôle" Margin="0,12,0,4"/>
            <ComboBox x:Name="RoleCombo" SelectionChanged="Role_Changed"/>
            <TextBlock x:Name="RoleHelp" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel x:Name="PasswordPanel">
            <TextBlock x:Name="PasswordLabel" Text="Mot de passe provisoire" Margin="0,12,0,4"/>
            <PasswordBox x:Name="PasswordBox" FontSize="13" Padding="6,5"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                       Text="8 caractères minimum, avec une lettre et un chiffre. La personne devra le changer à sa première connexion."/>
        </StackPanel>

        <CheckBox x:Name="ActiveBox" Content="Compte actif (peut se connecter)" IsChecked="True" Margin="0,14,0,0"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource BrushDangerDark}" Margin="0,12,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
            <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
