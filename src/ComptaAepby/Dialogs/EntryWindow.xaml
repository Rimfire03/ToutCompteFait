<Window x:Class="ComptaAepby.Dialogs.EntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Écriture" Width="720" SizeToContent="Height" MaxHeight="900" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BrushBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">
            <TextBlock x:Name="TitleText" Text="Nouvelle écriture" Style="{StaticResource TitleText}"/>

            <!-- Type -->
            <WrapPanel Margin="0,10,0,0">
                <RadioButton x:Name="ModeExpense" Content="Dépense" GroupName="mode" Checked="Mode_Changed" IsChecked="True"/>
                <RadioButton x:Name="ModeIncome" Content="Recette" GroupName="mode" Checked="Mode_Changed"/>
                <RadioButton x:Name="ModeReimbursed" Content="Remboursement reçu" GroupName="mode" Checked="Mode_Changed"
                             ToolTip="Argent remboursé à l'association (fournisseur, assurance…) : déduit de la charge concernée."/>
                <RadioButton x:Name="ModeTransfer" Content="Virement entre comptes" GroupName="mode" Checked="Mode_Changed"/>
                <RadioButton x:Name="ModeRefund" Content="Remboursement à un membre" GroupName="mode" Checked="Mode_Changed"/>
                <RadioButton x:Name="ModeNoCash" Content="Sans mouvement d'argent" GroupName="mode" Checked="Mode_Changed"
                             ToolTip="Refacturation interne : un produit et une charge de même montant, sans argent qui bouge."/>
            </WrapPanel>
            <TextBlock x:Name="ModeHelp" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Date" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DatePick"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Libellé (nature de l'opération)" Margin="0,0,0,4"/>
                    <TextBox x:Name="LabelBox"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock x:Name="AmountLabel" Text="Montant (€)" Margin="0,0,0,4"/>
                    <TextBox x:Name="AmountBox" HorizontalContentAlignment="Right" TextChanged="Amount_Changed"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="AccountPanel">
                    <TextBlock x:Name="AccountLabel" Text="Compte" Margin="0,0,0,4"/>
                    <ComboBox x:Name="AccountCombo" DisplayMemberPath="Name"/>
                </StackPanel>
                <StackPanel x:Name="ToAccountPanel" Grid.Column="2" Visibility="Collapsed">
                    <TextBlock Text="Vers le compte" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ToAccountCombo" DisplayMemberPath="Name"/>
                </StackPanel>
                <StackPanel x:Name="MemberPanel" Grid.Column="2" Visibility="Collapsed">
                    <TextBlock Text="Membre remboursé (achat fait avec son compte personnel)" Margin="0,0,0,4"/>
                    <TextBox x:Name="MemberBox"/>
                </StackPanel>
            </Grid>

            <!-- Dépense remboursée (remboursement reçu, total ou partiel) -->
            <StackPanel x:Name="RefundPanel" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock Text="Dépense remboursée (facultatif)" Margin="0,0,0,4"/>
                <ComboBox x:Name="RefundCombo" SelectionChanged="RefundCombo_Changed"/>
                <TextBlock x:Name="RefundInfo" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Ventilation -->
            <StackPanel x:Name="AllocSection">
                <TextBlock x:Name="AllocTitle" Text="Ventilation (produit ou charge concerné)" Style="{StaticResource SectionText}"/>
                <TextBlock x:Name="AllocHelp" Style="{StaticResource MutedText}" Margin="0,-4,0,8"/>
                <StackPanel x:Name="AllocPanel"/>
                <Button Content="＋  Ajouter une ligne de ventilation" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" Margin="0,6,0,0" Click="AddAlloc_Click"/>
                <Border x:Name="BalanceBox" Margin="0,10,0,0" Padding="10,7" CornerRadius="6" Background="#ECFDF5">
                    <TextBlock x:Name="BalanceText" FontWeight="SemiBold"/>
                </Border>
                <Border x:Name="OperationBox" Margin="0,8,0,0" Padding="10,8" CornerRadius="6" Background="#EFF6FF" Visibility="Collapsed">
                    <TextBlock x:Name="OperationText" TextWrapping="Wrap" Foreground="#1E3A8A"/>
                </Border>
            </StackPanel>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Note (facultatif)" Margin="0,0,0,4"/>
                    <TextBox x:Name="NoteBox"/>
                </StackPanel>
                <CheckBox x:Name="PointedBox" Grid.Column="1" Content="Pointé sur le relevé" Margin="16,22,0,0"/>
            </Grid>

            <!-- Justificatifs -->
            <StackPanel x:Name="AttachSection" Margin="0,14,0,0">
                <TextBlock Text="Justificatifs (facture, ticket, reçu…)" Style="{StaticResource SectionText}"/>
                <TextBlock x:Name="AttachHelp" Style="{StaticResource MutedText}" Margin="0,-4,0,6"
                           Text="Joignez le document qui justifie cette dépense (10 Mo maximum par fichier). Il est enregistré dans la base."/>
                <ListBox x:Name="AttachList" MinHeight="0" MaxHeight="120" MouseDoubleClick="AttachOpen_Click"/>
                <WrapPanel Margin="0,6,0,0">
                    <Button x:Name="AttachAddButton" Content="＋  Joindre un fichier…" Style="{StaticResource SecondaryButton}" Click="AttachAdd_Click"/>
                    <Button x:Name="AttachOpenButton" Content="Ouvrir" Style="{StaticResource SecondaryButton}" Click="AttachOpen_Click"/>
                    <Button x:Name="AttachRemoveButton" Content="Retirer" Style="{StaticResource SecondaryButton}" Click="AttachRemove_Click"/>
                </WrapPanel>
                <CheckBox x:Name="OptimizeBox" IsChecked="True" Margin="0,6,0,0"
                          Content="Réduire les photos et scans volumineux (économise de la place dans la base)"
                          ToolTip="Les images de plus de 300 Ko sont redimensionnées (2000 px max) et recompressées en JPEG. Le fichier d'origine n'est pas modifié. Les PDF ne sont pas touchés."/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource BrushDangerDark}" Margin="0,12,0,0" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Annuler" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
                <Button x:Name="SaveNewButton" Content="Enregistrer et saisir une autre" Style="{StaticResource SecondaryButton}" Click="SaveNew_Click"/>
                <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
