<Window x:Class="ComptaAepby.Dialogs.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compte" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BrushBackground}">
    <StackPanel Margin="22">
        <TextBlock x:Name="TitleText" Text="Compte" Style="{StaticResource TitleText}"/>
        <TextBlock Text="Nom du compte" Margin="0,12,0,4"/>
        <TextBox x:Name="NameBox"/>
        <TextBlock Text="Type" Margin="0,12,0,4"/>
        <ComboBox x:Name="KindCombo"/>
        <CheckBox x:Name="ActiveBox" Content="Compte actif (proposé à la saisie)" IsChecked="True" Margin="0,12,0,0"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource BrushDangerDark}" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
            <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
