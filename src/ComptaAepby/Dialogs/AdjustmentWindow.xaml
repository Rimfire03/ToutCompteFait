<Window x:Class="ComptaAepby.Dialogs.AdjustmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report entre années" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BrushBackground}">
    <StackPanel Margin="22">
        <TextBlock x:Name="TitleText" Text="Nouveau report" Style="{StaticResource TitleText}"/>
        <TextBlock x:Name="CarriedNote" Style="{StaticResource MutedText}" Visibility="Collapsed" Margin="0,0,0,8"
                   Text="Cette ligne vient automatiquement de l'exercice précédent : seule sa catégorie peut être choisie ici."/>

        <TextBlock Text="De quoi s'agit-il ?" Margin="0,10,0,4"/>
        <ComboBox x:Name="TypeCombo" SelectionChanged="Type_Changed"/>
        <TextBlock x:Name="TypeHelp" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <RadioButton x:Name="KindCharge" Content="C'est une charge (dépense)" IsChecked="True" Checked="Kind_Changed"/>
            <RadioButton x:Name="KindProduct" Content="C'est un produit (recette)" Checked="Kind_Changed"/>
        </StackPanel>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Intitulé" Margin="0,0,0,4"/>
                <TextBox x:Name="LabelBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Montant (€)" Margin="0,0,0,4"/>
                <TextBox x:Name="AmountBox" HorizontalContentAlignment="Right"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="CatLabel" Text="Catégorie concernée (cet exercice)" Margin="0,12,0,4"/>
        <ComboBox x:Name="CatCombo" DisplayMemberPath="Name"/>

        <StackPanel x:Name="TargetPanel">
            <TextBlock Text="Catégorie qui recevra ce montant l'an prochain" Margin="0,12,0,4"/>
            <ComboBox x:Name="TargetCombo" IsEditable="True"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                       Text="Ex. des lots de loto payés en juin et rangés dans « Loto n+1 » : l'an prochain ils compteront dans « Loto Octobre »."/>
        </StackPanel>

        <TextBlock Text="Note (facultatif)" Margin="0,12,0,4"/>
        <TextBox x:Name="NoteBox"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource BrushDangerDark}" Margin="0,12,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
            <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
