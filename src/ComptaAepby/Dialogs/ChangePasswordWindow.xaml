<Window x:Class="ComptaAepby.Dialogs.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Changer le mot de passe" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BrushBackground}">
    <StackPanel Margin="26">
        <TextBlock Text="Changer le mot de passe" Style="{StaticResource TitleText}"/>
        <TextBlock x:Name="ForcedNote" Style="{StaticResource MutedText}" Visibility="Collapsed"
                   Text="Votre mot de passe est provisoire : choisissez-en un nouveau pour continuer."/>
        <TextBlock Text="Mot de passe actuel" Margin="0,16,0,4"/>
        <PasswordBox x:Name="CurrentBox" FontSize="13" Padding="6,5"/>
        <TextBlock Text="Nouveau mot de passe" Margin="0,12,0,4"/>
        <PasswordBox x:Name="NewBox" FontSize="13" Padding="6,5"/>
        <TextBlock Text="Confirmer le nouveau mot de passe" Margin="0,12,0,4"/>
        <PasswordBox x:Name="ConfirmBox" FontSize="13" Padding="6,5"/>
        <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                   Text="8 caractères minimum, avec au moins une lettre et un chiffre."/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource BrushDangerDark}" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Annuler" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
            <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
