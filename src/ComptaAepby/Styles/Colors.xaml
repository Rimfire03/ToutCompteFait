<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Même palette que l'application Filtres (Tailwind) -->
    <SolidColorBrush x:Key="BrushPrimary" Color="#2563EB"/>
    <SolidColorBrush x:Key="BrushPrimaryDark" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="BrushPrimaryLight" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="BrushPrimaryMedium" Color="#DBEAFE"/>

    <SolidColorBrush x:Key="BrushDanger" Color="#EF4444"/>
    <SolidColorBrush x:Key="BrushDangerDark" Color="#DC2626"/>
    <SolidColorBrush x:Key="BrushDangerLight" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="BrushSuccess" Color="#10B981"/>
    <SolidColorBrush x:Key="BrushSuccessDark" Color="#059669"/>
    <SolidColorBrush x:Key="BrushSuccessLight" Color="#ECFDF5"/>
    <SolidColorBrush x:Key="BrushWarning" Color="#F59E0B"/>
    <SolidColorBrush x:Key="BrushWarningDark" Color="#D97706"/>
    <SolidColorBrush x:Key="BrushWarningLight" Color="#FFFBEB"/>

    <SolidColorBrush x:Key="BrushBackground" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="BrushSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushSurfaceHover" Color="#F1F5F9"/>

    <SolidColorBrush x:Key="BrushSidebar" Color="#0F172A"/>
    <SolidColorBrush x:Key="BrushSidebarHover" Color="#1E293B"/>
    <SolidColorBrush x:Key="BrushSidebarSelected" Color="#2563EB"/>
    <SolidColorBrush x:Key="BrushSidebarBorder" Color="#334155"/>

    <SolidColorBrush x:Key="BrushTextPrimary" Color="#0F172A"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#64748B"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="#94A3B8"/>
    <SolidColorBrush x:Key="BrushTextOnDark" Color="#F8FAFC"/>

    <SolidColorBrush x:Key="BrushBorder" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BrushBorderStrong" Color="#CBD5E1"/>

</ResourceDictionary>
