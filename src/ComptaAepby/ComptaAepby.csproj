<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>12</LangVersion>
    <AssemblyName>ToutCompteFait</AssemblyName>
    <RootNamespace>ComptaAepby</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.0.3</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Company>TomLine prod&amp;co</Company>
    <Product>Tout Compte Fait</Product>
    <Copyright>© TomLine prod&amp;co by Thomas Guidez</Copyright>
  </PropertyGroup>

  <!-- Canal de la build (posé par tools\Release.ps1 -Channel dev : -p:ReleaseChannel=dev) : lu par App.DisplayVersion. -->
  <ItemGroup Condition="'$(ReleaseChannel)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ReleaseChannel</_Parameter1>
      <_Parameter2>$(ReleaseChannel)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <!-- Texte des PDF numériques (sans OCR) ; l'OCR et le rendu des pages utilisent Windows (Windows.Media.Ocr / Windows.Data.Pdf). -->
    <PackageReference Include="PdfPig" Version="0.1.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ComptaAepby.Core\ComptaAepby.Core.csproj" />
  </ItemGroup>

</Project>
