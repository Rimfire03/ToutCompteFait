<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="tomline" value="https://nuget.pkg.github.com/Rimfire03/index.json" />
  </packageSources>
  <!-- Le jeton (PAT read:packages) vient de la variable d'environnement TOMLINE_NUGET_TOKEN : jamais dans le dépôt. -->
  <packageSourceCredentials>
    <tomline>
      <add key="Username" value="Rimfire03" />
      <add key="ClearTextPassword" value="%TOMLINE_NUGET_TOKEN%" />
    </tomline>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="tomline">
      <package pattern="TomLine.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
